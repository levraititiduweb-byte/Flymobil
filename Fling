-- ===== LOGIQUE DU FLING =====

-- Fonction pour fling les joueurs proches
local function executeFling()
    if isFlinging then return end
    isFlinging = true
    
    local char = LocalPlayer.Character
    if not char then isFlinging = false return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then isFlinging = false return end

    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local targetHrp = player.Character:FindFirstChild("HumanoidRootPart")
            if targetHrp then
                local distance = (targetHrp.Position - hrp.Position).Magnitude
                if distance <= FlingRadius then
                    -- Technique de fling par rotation (bypass les anti-cheats basiques)
                    local velocity = Instance.new("BodyAngularVelocity")
                    velocity.Name = "BreadFling"
                    velocity.AngularVelocity = Vector3.new(9999, 9999, 9999)
                    velocity.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
                    velocity.Parent = targetHrp
                    
                    task.wait(0.1)
                    if velocity then velocity:Destroy() end
                end
            end
        end
    end
    
    task.wait(0.5)
    isFlinging = false
end

-- Détection de la touche ESPACE (pour déclencher le fling)
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == Enum.KeyCode.Space and FlingEnabled then
        StatusLabel.Text = "Status: FLING EN COURS !"
        StatusLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
        executeFling()
        task.wait(0.5)
        if FlingEnabled then
            StatusLabel.Text = "Status: Prêt.\nAppuyez sur ESPACE pour Fling"
            StatusLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
        end
    end
end)

-- Gestion du bouton ON/OFF
local touchStartPos = nil
ToggleFlingBtn.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
        touchStartPos = input.Position
    end
end)

ToggleFlingBtn.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
        if touchStartPos and (input.Position - touchStartPos).Magnitude < 15 then
            FlingEnabled = not FlingEnabled
            if FlingEnabled then
                ToggleFlingBtn.Text = "Activer Fling: ON"
                ToggleFlingBtn.BackgroundColor3 = Color3.fromRGB(50, 150, 50)
                StatusLabel.Text = "Status: Prêt.\nAppuyez sur ESPACE pour Fling"
            else
                ToggleFlingBtn.Text = "Activer Fling: OFF"
                ToggleFlingBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
                StatusLabel.Text = "Status: Désactivé."
            end
        end
        touchStartPos = nil
    end
end)

